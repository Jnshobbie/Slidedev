// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id String @id @default(uuid())
  name String 
  userId String
  projectType String @default("web") // "web" or "mobile"
  model       String @default("gpt-5.2") // model switcher
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id String @id @default(uuid())
  content String 
  role MessageRole
  type MessageType
  attachments Json? // Store file URLs and metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fragment Fragment?
}

model Fragment {
  id String @id @default(uuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl String
  title String
  files Json
  dependencies Json? // NEW: Store npm dependencies for mobile apps

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
}

model Usage {
  key String @id 
  points Int 
  expire DateTime?
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique
  plan               String    @default("free")
  status             String    @default("inactive")
  expiresAt          DateTime?
  lsSubscriptionId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model IdeToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model IdeUsage {
  id          String   @id @default(cuid())
  userId      String   @unique
  sonnetTokensUsed  Int  @default(0)
  opusTokensUsed    Int  @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IdeConversation {
  id         String   @id @default(cuid())
  userId     String
  title      String
  folderPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  IdeMessage[]
}

model IdeMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   IdeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String          // "user" | "assistant"
  content        String          @db.Text
  createdAt      DateTime        @default(now())
}

model FigmaImport {
  id         String   @id @default(uuid())
  importId   String   @unique
  userId     String
  fileName   String
  designData String   @db.Text
  imageUrls  String   @db.Text
  sectionImages String @db.Text @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}