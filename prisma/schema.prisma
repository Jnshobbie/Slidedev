// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Project {
  id String @id @default(uuid())
  name String 
  userId String
  projectType String @default("web") // "web" or "mobile"
  model       String @default("gpt-5.2") // model switcher
  gsapMode    Boolean @default(false) // GSAP Motion mode toggle
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id String @id @default(uuid())
  content String 
  role MessageRole
  type MessageType
  attachments Json? // Store file URLs and metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fragment Fragment?
}

model Fragment {
  id String @id @default(uuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl String
  title String
  files Json
  dependencies Json? // NEW: Store npm dependencies for mobile apps

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
}

model Usage {
  key String @id 
  points Int 
  expire DateTime?
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique
  plan               String    @default("free")
  status             String    @default("inactive")
  expiresAt          DateTime?
  lsSubscriptionId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model IdeToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model IdeUsage {
  id          String   @id @default(cuid())
  userId      String   @unique
  sonnetTokensUsed  Int  @default(0)
  opusTokensUsed    Int  @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IdeConversation {
  id         String   @id @default(cuid())
  userId     String
  title      String
  folderPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  IdeMessage[]
}

model IdeMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   IdeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String          // "user" | "assistant"
  content        String          @db.Text
  createdAt      DateTime        @default(now())
}

model FigmaImport {
  id         String   @id @default(uuid())
  importId   String   @unique
  userId     String
  fileName   String
  designData String   @db.Text
  imageUrls  String   @db.Text
  sectionImages String @db.Text @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// GSAP Mode: retrieval library of tagged animation patterns.
// Populated once by scripts/gsap-ingest/*.js, read at generation time
// by src/lib/gsap-patterns.ts.
// GSAP Mode: retrieval library of tagged animation patterns.
// Populated once by scripts/gsap-ingest/*.js, read at generation time
// by src/lib/gsap-patterns.ts.
model DesignPattern {
  id          String   @id @default(cuid())
  category    String   @default("gsap") // "gsap" | "mobile-ui" | "landing-page" | "motion"
  technique   String   // e.g. "scroll-triggered card stagger reveal"
  mood        String   // "minimal-snappy" | "bold-elastic" | "cinematic-slow" | "playful-bouncy" | "luxury-smooth"
  framework   String   // "vanilla" | "react" | "react-native" | "nextjs"
  description String   @db.Text
  usageNote   String?  @db.Text // how the calling agent should adapt this snippet
  constraints        String?  @db.Text // when this pattern does/doesn't fit
  antiPatterns       String?  @db.Text // common mistakes when adapting this pattern
  accessibilityNotes String?  @db.Text
  motionBudget       String?  @db.Text // relative "how much" motion this adds, for pacing a page
  sourceRepo  String?  // e.g. "wix/react-native-ui-lib" — the open-source repo this pattern was pulled from
  license     String?  // "MIT" or "unconfirmed" — never assume permissive reuse without a verified LICENSE file
  code        String   @db.Text
  params      Json?
  embedding   Unsupported("vector(1024)")
  createdAt   DateTime @default(now())

  @@index([mood])
  @@index([technique])
  @@index([category])
  @@map("GsapAnimationPattern") // keeps the real table name so the existing 29 rows aren't touched
}